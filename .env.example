# Copy to .env before running anything outside Docker Compose.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://icp:icp@localhost:5432/icp?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://icp:icp@localhost:5672

# Must be at least 16 characters. Replace before any real deployment.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Simulated hardware behaviour, so the async + failure paths are observable.
PROVISION_DELAY_MS=2000
PROVISION_FAILURE_RATE=0
